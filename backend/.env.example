# =============================================================================
# ResearchPaperRAG — Backend Environment Configuration
# =============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the 'backend' folder (or root):
#      cp backend/.env.example backend/.env
# 2. Add at least one API key (Google Gemini or Groq recommended for free tier).
# 3. Never commit '.env' containing real secrets to version control!
# =============================================================================

# =============================================================================
# 1. LLM Provider API Keys
# =============================================================================
# Each key you configure unlocks that provider for generation and automatic failover.
# Multiple keys can be comma-separated for automatic round-robin / rate-limit balancing.

# --- Google Gemini (Recommended Default) ---
# Free tier available. Default model: gemini-3.8-flash
# Get your free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# Optional multiple keys: GOOGLE_API_KEYS=key1,key2,key3

# --- Groq (Ultra-Fast LPU Inference) ---
# Free tier available. Models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
# Get your free key at: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_groq_key_here
# Optional multiple keys: GROQ_API_KEYS=gsk_key1,gsk_key2

# --- SambaNova Cloud (High Token Rate Limits) ---
# Free tier available. Models: DeepSeek-V3.1, Meta-Llama-3.3-70B-Instruct, DeepSeek-V3.2
# Get your free key at: https://cloud.sambanova.ai/
# SAMBANOVA_API_KEY=your_sambanova_api_key_here

# --- OpenRouter (Aggregated Free Models) ---
# Free tier models: openrouter/free, google/gemma-4-31b-it:free, nvidia/nemotron-3.5-lightning:free
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- Hugging Face (Embeddings) ---
# Used for remote embeddings fallback; get your token at: https://huggingface.co/settings/tokens
# HF_API_KEY=hf_your_token_here

# --- Direct OpenAI API (Optional Fallback) ---
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_DIRECT_API_KEY=sk-your_openai_key_here


# =============================================================================
# 2. Default Provider & Model Selection
# =============================================================================
# Primary provider to use when the client does not specify one.
# Choices: gemini, groq, sambanova, openrouter
DEFAULT_PROVIDER=gemini

# Primary model identifier matching the DEFAULT_PROVIDER.
# Gemini:     gemini-3.8-flash (default), gemini-3.5-flash-lite
# Groq:       openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
# SambaNova:  DeepSeek-V3.1, Meta-Llama-3.3-70B-Instruct, gpt-oss-120b
# OpenRouter: openrouter/free, google/gemma-4-31b-it:free, nvidia/nemotron-3.5-lightning:free
DEFAULT_MODEL=gemini-3.8-flash


# =============================================================================
# 4. Generation & Budget Parameters
# =============================================================================
# Sampling temperature (0.0 for deterministic, factual research extraction)
TEMPERATURE=0.0

# General completion token cap
MAX_TOKENS=2048

# Maximum estimated token budget allocated for retrieved passage evidence in prompts
CONTEXT_TOKEN_BUDGET=4000

# Maximum token cap for generated multi-facet research gap reports
REPORT_MAX_TOKENS=3500

# Maximum token cap for follow-up question responses
FOLLOWUP_MAX_TOKENS=800

# Maximum retry / failover attempts across configured providers before failing closed
LLM_MAX_ATTEMPTS=3

# Individual network attempt timeout in seconds
LLM_TIMEOUT_SECONDS=30

# Cumulative end-to-end deadline in seconds across all retries
LLM_REQUEST_DEADLINE_SECONDS=60

# Concurrency throttle: maximum simultaneous LLM synthesis requests processed
MAX_CONCURRENT_REQUESTS=4


# =============================================================================
# 5. Chunking & RAG Retrieval Settings
# =============================================================================
# MiniLM tokenizer-aware word-piece budget (model ceiling is 256 tokens).
# 224 tokens with 32 overlap ensures clean passage boundaries without truncation.
EMBEDDING_CHUNK_TOKENS=224
EMBEDDING_OVERLAP_TOKENS=32

# Fallback character chunking settings (for legacy callers)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Top-k passages retrieved per facet during search
RETRIEVAL_K=4

# Embeddings: local CPU Sentence Transformers ('all-MiniLM-L6-v2') by default (free, private).
# Set to 'true' only if you want to use remote provider embedding endpoints.
EMBEDDING_USE_REMOTE=false
EMBEDDING_OPENAI_DIRECT=false


# =============================================================================
# 6. Document & PDF Parsing Limits
# =============================================================================
# Maximum page count allowed per uploaded or fetched research PDF
MAX_PDF_PAGES=200

# Maximum character text extraction ceiling per document
MAX_EXTRACTED_CHARS=500000

# Maximum total chunks stored per research session index
MAX_DOCUMENT_CHUNKS=1000

# Virtual memory limit (in MB) for the disposable PDF parser subprocess (Linux/Unix)
PDF_MEMORY_LIMIT_MB=512


# =============================================================================
# 7. FAISS Vector Store Persistence & Storage
# =============================================================================
# Directory for serialized FAISS index and JSON docstores (relative to backend/)
FAISS_PERSIST_DIR=faiss_index

# Maximum number of concurrent research sessions kept in memory/disk LRU cache
MAX_VECTOR_SESSIONS=64

# Cleanup threshold: remove inactive session directories older than N days on startup
FAISS_SESSION_MAX_AGE_DAYS=3


# =============================================================================
# 8. Rate Limiting (Per Client IP)
# =============================================================================
# Rolling 60-second window rate limits (0 = disabled).
# Evaluated per client IP; requires TRUSTED_PROXY_IPS when deployed behind reverse proxy.
RATE_LIMIT_UPLOAD_PER_MINUTE=8
RATE_LIMIT_ASK_PER_MINUTE=90


# =============================================================================
# 9. Networking, CORS & Proxy Security
# =============================================================================
# Comma-separated list of allowed browser origins for CORS.
# For local dev: http://localhost:5173,http://127.0.0.1:5173
# For Cloudflare Pages: https://your-project.pages.dev
# Use '*' only for open public API testing.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Allowed HTTP Host header values (blocks Host Header Poisoning)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated IP addresses or CIDR ranges of trusted immediate reverse proxies
# (e.g. Nginx, Cloudflare, Traefik). Only trusted proxies may supply X-Real-IP.
TRUSTED_PROXY_IPS=

# Enable verbose application debugging output (set false in production)
DEBUG=false


# =============================================================================
# 10. Monitoring & Telemetry (Optional)
# =============================================================================
# Sentry DSN for backend exception tracking. If omitted, telemetry is completely disabled.
# SENTRY_DSN=https://public-key@o123.ingest.sentry.io/456
# SENTRY_ENVIRONMENT=production

# Optional legacy Sentry relay tunnel endpoint
# TELEMETRY_TUNNEL_DSN=https://public-key@o123.ingest.sentry.io/456
