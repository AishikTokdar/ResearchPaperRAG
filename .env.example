# =============================================================================
# ResearchPaperRAG — Root & Docker Environment Configuration
# =============================================================================
# Instructions:
# 1. Copy this file to '.env' at the repository root or backend/.env:
#      cp .env.example backend/.env
# 2. Configure at least one LLM API key (Google Gemini or Groq recommended).
# 3. For Docker Compose:
#      docker compose --env-file backend/.env up --build -d
# =============================================================================

# =============================================================================
# 1. Primary AI Provider API Keys
# =============================================================================
# Google Gemini (Default — free tier available at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq (Ultra-fast LPU inference — free tier at https://console.groq.com/keys)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# SambaNova (High rate limits — free tier at https://cloud.sambanova.ai/)
# SAMBANOVA_API_KEY=your_sambanova_api_key_here

# OpenRouter (Aggregated free models — https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Cerebras (Trial credits — https://cloud.cerebras.ai/)
# CEREBRAS_API_KEY=csk-your_cerebras_api_key_here

# Hugging Face Router (Inference credits — https://huggingface.co/settings/tokens)
# HF_API_KEY=hf_your_token_here

# Direct OpenAI API
# OPENAI_DIRECT_API_KEY=sk-your_openai_key_here


# =============================================================================
# 2. Credit Safeguards & Default Model
# =============================================================================
# Set true only if you want to allow trial/paid providers (Cerebras, Hugging Face)
ALLOW_CREDIT_PROVIDERS=false

# Default provider and model selection
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-3.8-flash


# =============================================================================
# 3. RAG, Generation & Evidence Budgets
# =============================================================================
TEMPERATURE=0.0
MAX_TOKENS=2048
CONTEXT_TOKEN_BUDGET=4000
REPORT_MAX_TOKENS=3500
FOLLOWUP_MAX_TOKENS=800
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=30
LLM_REQUEST_DEADLINE_SECONDS=60
MAX_CONCURRENT_REQUESTS=4

# Tokenizer chunking for all-MiniLM-L6-v2 (224 word pieces + 32 overlap)
EMBEDDING_CHUNK_TOKENS=224
EMBEDDING_OVERLAP_TOKENS=32
RETRIEVAL_K=4
EMBEDDING_USE_REMOTE=false


# =============================================================================
# 4. Document & PDF Parsing Limits
# =============================================================================
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARS=500000
MAX_DOCUMENT_CHUNKS=1000
PDF_MEMORY_LIMIT_MB=512


# =============================================================================
# 5. Storage & Persistence
# =============================================================================
FAISS_PERSIST_DIR=faiss_index
MAX_VECTOR_SESSIONS=64
FAISS_SESSION_MAX_AGE_DAYS=3


# =============================================================================
# 6. Rate Limits & Security
# =============================================================================
RATE_LIMIT_UPLOAD_PER_MINUTE=8
RATE_LIMIT_ASK_PER_MINUTE=90

# Allowed CORS origins (comma-separated). Set to your Cloudflare Pages URL in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Allowed HTTP host headers
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Trusted reverse proxy IPs/CIDRs
TRUSTED_PROXY_IPS=
DEBUG=false


# =============================================================================
# 7. Frontend Build & Gateway Configuration
# =============================================================================
# For same-origin Docker/Nginx: leave empty.
# For separate frontend hosting (Cloudflare Pages): https://your-space.hf.space
VITE_API_BASE_URL=
