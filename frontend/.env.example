# =============================================================================
# ResearchPaperRAG — Frontend Environment Configuration
# =============================================================================
# Instructions:
# 1. Copy this file to '.env.local' or '.env' inside the 'frontend' directory:
#      cp frontend/.env.example frontend/.env.local
# 2. In production (Cloudflare Pages, Docker), environment variables must be
#    supplied at build time because Vite bundles them into static JavaScript.
# =============================================================================

# =============================================================================
# 1. Backend API Origin
# =============================================================================
# --- Local Development ---
# Direct API origin (FastAPI default port is 8000).
# The Vite dev server proxies /api/ requests to this origin.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional custom Vite dev proxy target if backend runs on a different port/host:
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
# VITE_BACKEND_PORT=8000

# --- Cloudflare Pages + Hugging Face Hosted Deployment ---
# Point to your deployed Hugging Face Space HTTPS URL (WITHOUT trailing slash or /api suffix):
# VITE_API_BASE_URL=https://your-username-research-rag.hf.space

# --- Same-Origin Production (Docker / Nginx) ---
# Leave VITE_API_BASE_URL empty when served by the included Nginx reverse proxy
# which routes /api/ requests to the backend container directly on the same domain:
# VITE_API_BASE_URL=


# =============================================================================
# 2. Client Telemetry & Error Tracking (Optional)
# =============================================================================
# Sentry DSN for frontend exception monitoring.
# Privacy Guarantee: Sentry session replay, request body logging, query text,
# document content, and PII are strictly stripped/disabled.
# Leave commented out to disable telemetry completely.
# VITE_SENTRY_DSN=https://public-key@o123.ingest.sentry.io/456
# VITE_APP_ENV=production
